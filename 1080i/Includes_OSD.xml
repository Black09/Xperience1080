                <posx>1218</posx>
                <posy>0</posy>
                <width>702</width>
                <height>194</height>
                <texture>osd/fullscreen/osd-back-weatherclock.png</texture>
                <aspectratio>stretch</aspectratio>
            </control>
            <control type="group">
                <visible>![stringcompare(Weather.FanartCode,na) + substring(Weather.Conditions,/)]</visible>
