<window id="609">
	<defaultcontrol always="true">11</defaultcontrol>
	<zorder>3</zorder>
	<controls>
		<control type="group">
			<include>NowPlayingFullscreen</include>
			<include>FullscreenDimensions</include>
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture>osd/fullscreen/osdsettings.png</texture>
				<aspectratio>stretch</aspectratio>
				<visible>IsEmpty(Skin.String(pvr.channelosd.pos))</visible>
			</control>
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture>osd/fullscreen/osdchannels-left.png</texture>
				<aspectratio>stretch</aspectratio>
				<visible>stringcompare(Skin.String(pvr.channelosd.pos),1)</visible>
			</control>
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture>osd/fullscreen/osdchannels-right.png</texture>
				<aspectratio>stretch</aspectratio>
				<visible>stringcompare(Skin.String(pvr.channelosd.pos),2)</visible>
			</control>
			<include condition="IsEmpty(Skin.String(pvr.channelosd.pos))">PVRChannelOSDMiddle</include>
			<include condition="!IsEmpty(Skin.String(pvr.channelosd.pos))">PVRChannelOSDLeftRight</include>
		</control>
	</controls>
</window>